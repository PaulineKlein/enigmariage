<?xml version="1.0" encoding="utf-8"?><!-- Mirrors ui/atome/AppButton (Primary): vertical gradient fill, lighter top edge on the border, grey when disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gradient_endColorFonce">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/grey" />
                    <corners android:radius="@dimen/button_radius" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/grey" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="@color/gradient_endColorFonce"
                                android:startColor="@color/button_border_top" />
                            <corners android:radius="@dimen/button_radius" />
                        </shape>
                    </item>
                    <item
                        android:bottom="1dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="1dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="@color/button_fill_bottom_pressed"
                                android:startColor="@color/button_fill_top_pressed" />
                            <corners android:radius="@dimen/button_radius_inner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="@color/gradient_endColorFonce"
                                android:startColor="@color/button_border_top" />
                            <corners android:radius="@dimen/button_radius" />
                        </shape>
                    </item>
                    <item
                        android:bottom="1dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="1dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="@color/gradient_endColor"
                                android:startColor="@color/button_fill_top" />
                            <corners android:radius="@dimen/button_radius_inner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
