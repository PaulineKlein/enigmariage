<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/margin_16">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_photobooth_two_message_1"
        style="@style/Body_big"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_16"
        android:text="@string/photobooth_three_message_1"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@id/layout_zoom"
        app:layout_constraintEnd_toStartOf="@id/iv_photographe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <include
        android:id="@+id/layout_zoom"
        layout="@layout/zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_photographe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_photobooth_two_message_1" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_photographe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/image_enigme_accessibility"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_photobooth_two_message_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        tools:srcCompat="@drawable/image_photographe_rabbit" />

</androidx.constraintlayout.widget.ConstraintLayout>