<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/margin_16">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_coktail_seven_message_1"
        style="@style/Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/coktail_seven_message_1"
        android:textAlignment="center"
        android:padding="@dimen/margin_16"
        app:layout_constraintBottom_toTopOf="@+id/tv_cocktail_seven_message_gourde"
        app:layout_constraintEnd_toStartOf="@+id/iv_cocktail_gourde"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_cocktail_seven_message_gourde"
        style="@style/Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/coktail_seven_message_2"
        android:textAlignment="center"
        android:textStyle="bold"
        android:padding="@dimen/margin_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_cocktail_gourde"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_coktail_seven_message_1" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_cocktail_gourde"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/image_gourde"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_coktail_seven_message_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>