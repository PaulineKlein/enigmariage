<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_12"
    android:background="@drawable/background_popup"
    android:padding="@dimen/margin_16">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_trophy_item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_trophy" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_trophy_item_title"
        style="@style/SousTitre"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_trophy_item_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Mon Succès" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_trophy_item_message"
        style="@style/Body"
        android:textSize="14sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_trophy_item_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_trophy_item_title"
        tools:text="Mon message" />

</androidx.constraintlayout.widget.ConstraintLayout>
