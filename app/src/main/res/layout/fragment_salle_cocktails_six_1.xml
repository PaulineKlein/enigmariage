<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_cocktail_six_message_1"
        style="@style/Body_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cocktail_six_message_1"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/iv_cocktail_gourde"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_cocktail_gourde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_24"
        android:adjustViewBounds="true"
        android:contentDescription="@string/salle_cocktails_gourde_accessibility_rabbit"
        android:cropToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/tv_cocktail_six_message_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_cocktail_six_message_1"
        app:srcCompat="@drawable/image_gourde_rabbit" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_cocktail_six_message_2"
        style="@style/Body_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_24"
        android:text="@string/cocktail_six_message_2"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_cocktail_gourde" />

</androidx.constraintlayout.widget.ConstraintLayout>